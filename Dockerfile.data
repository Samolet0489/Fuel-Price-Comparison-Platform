FROM python:3.14-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-data.lock ./
RUN pip install --no-cache-dir -r requirements-data.lock
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 libbz2-1.0 \
    && rm -rf /var/lib/apt/lists/*
COPY fuel_stop ./fuel_stop
COPY scripts ./scripts
ENTRYPOINT ["python", "-m", "scripts.extract_stations"]
