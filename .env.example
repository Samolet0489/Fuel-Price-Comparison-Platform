# Local Python defaults; no routing account or API key is needed.
# Compose sets OSRM_BASE_URL=http://osrm:5000 and mounts the boundary itself.
OSRM_BASE_URL=http://127.0.0.1:5000
AUSTRIA_BOUNDARY_FILE=data/osrm/austria-boundary.geojson
# Default station retrieval reads the real map snapshot, without an HTTP lookup.
STATION_SOURCE=local
STATION_CATALOGUE_FILE=data/osrm/stations.json
# Optional explicit online diagnostic mode: STATION_SOURCE=overpass (local Python).
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Compose reads .env for optional values. Local Python uses shell variables.
# Leave price settings blank until you have permission to use a real source.
PRICE_FEED_URL=
# Set observed to use a configured HTTP feed or local observations.
PRICE_MODE=generated
# With the TomTom updater, set this to /data/tomtom-prices.json in Compose.
PRICE_SNAPSHOT_FILE=
PRICE_SOURCE=
PRICE_PERMISSION_REFERENCE=
PRICE_FEED_TOKEN=
